{
  "framework": null,
  "installCommand": "echo \"Skipping package install\"",
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/((?!assets/|canvaskit/|icons/|favicon.png|manifest.json|flutter.js|flutter_bootstrap.js|main.dart.js|version.json|safari_reset.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
