{
  "name": "Haenggung Dagwa",
  "source": "demo ver0 Flutter Web",
  "figmaFrames": {
    "desktop": { "width": 1440, "height": 1024 },
    "wideDesktop": { "width": 1728, "height": 1117 },
    "mobileReference": { "width": 390, "height": 844 }
  },
  "layout": {
    "contentMaxWidth": 1180,
    "desktopHorizontalPadding": 24,
    "mobileHorizontalPadding": 18,
    "sectionVerticalPadding": 92,
    "radius": 8
  },
  "colors": {
    "cream": "#F7EFE4",
    "paper": "#FFFCF7",
    "hanji": "#F1E7D8",
    "wheat": "#D8C5AA",
    "porcelain": "#E9F0EC",
    "deep": "#211817",
    "brown": "#604537",
    "cinnabar": "#87352D",
    "gold": "#C19A5B",
    "jade": "#2F6F5E",
    "plum": "#6A3A4A",
    "muted": "#6D6258",
    "shadow": "rgba(33, 24, 23, 0.2)"
  },
  "typography": {
    "bodyFamily": "Noto Sans KR",
    "displayFamily": "Noto Serif KR",
    "fallbackSerif": ["AppleMyungjo", "serif"],
    "styles": {
      "sectionEyebrow": {
        "fontFamily": "Noto Sans KR",
        "fontSize": 11,
        "fontWeight": 600,
        "letterSpacing": 4,
        "lineHeight": 1.2
      },
      "sectionTitle": {
        "fontFamily": "Noto Serif KR",
        "fontSize": 40,
        "fontWeight": 700,
        "lineHeight": 1.22
      },
      "sectionTitleMobile": {
        "fontFamily": "Noto Serif KR",
        "fontSize": 27,
        "fontWeight": 700,
        "lineHeight": 1.22
      },
      "sectionDescription": {
        "fontFamily": "Noto Sans KR",
        "fontSize": 16,
        "fontWeight": 300,
        "lineHeight": 1.82
      },
      "button": {
        "fontFamily": "Noto Sans KR",
        "fontSize": 14,
        "fontWeight": 700,
        "lineHeight": 1.2
      },
      "tag": {
        "fontFamily": "Noto Sans KR",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 1.2
      }
    }
  },
  "components": {
    "softCard": {
      "fill": "paper",
      "border": "wheat",
      "borderOpacity": 0.58,
      "radius": 8,
      "padding": 26,
      "shadow": "0 14 22 -10 rgba(33,24,23,0.1)"
    },
    "primaryButton": {
      "fill": "deep",
      "foreground": "paper",
      "radius": 8,
      "paddingX": 24,
      "paddingY": 16
    },
    "outlinedButton": {
      "foreground": "deep",
      "border": "rgba(33,24,23,0.45)",
      "radius": 8,
      "paddingX": 24,
      "paddingY": 16
    },
    "field": {
      "fill": "rgba(241,231,216,0.5)",
      "border": "wheat",
      "focusBorder": "gold",
      "focusBorderWidth": 1.5,
      "radius": 8,
      "paddingX": 14,
      "paddingY": 14
    },
    "tagPill": {
      "fill": "rgba(193,154,91,0.1)",
      "border": "rgba(193,154,91,0.3)",
      "radius": 999,
      "paddingX": 10,
      "paddingY": 5
    }
  }
}
